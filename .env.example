# Database configuration
# Railway injects DATABASE_URL. For local testing, if not set, sqlite:///./fake_detection.db is used as a fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fake_detection

# API Settings
API_PREFIX=/api
PROJECT_NAME="Hybrid Multimodal Fake Content Detection"
PORT=8000
HOST=0.0.0.0

# CORS settings (comma-separated list of origins)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Cache (Hugging Face & EasyOCR download directories)
HF_HOME=./cache/huggingface
EASYOCR_CACHE=./cache/easyocr
TORCH_HOME=./cache/torch

# Enable simulated fallback for heavy ML weight inference if CPU limits/RAM/downloads fail
ENABLE_MOCK_FALLBACK=True
